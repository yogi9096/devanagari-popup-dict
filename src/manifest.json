{
  "manifest_version": 3,
  "name": "English to Hindi Popup Dictionary",
  "short_name": "Hindi Dict",
  "version": "0.3.0",
  "description": "Select an English word to see its Hindi meaning, pronunciation and part of speech. Works offline, no tracking.",
  "author": "Devanagari Popup Dictionary contributors",
  "homepage_url": "https://github.com/yogi9096/devanagari-popup-dict",

  "browser_specific_settings": {
    "gecko": {
      "id": "devanagari-dict@yogi9096.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "common/compat.js",
      "common/settings.js",
      "background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "common/compat.js",
        "common/devanagari.js",
        "common/normalize.js",
        "common/translit.js",
        "common/pos-labels.js",
        "common/morphology.js",
        "common/selection.js",
        "common/settings.js",
        "common/dictionary.js",
        "common/tooltip.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],

  "action": {
    "default_title": "Devanagari Popup Dictionary",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn the dictionary on or off for the current site"
    },
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Look up the selected word"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["dict/*.json"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
